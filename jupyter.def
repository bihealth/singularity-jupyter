BootStrap: docker
From: mambaorg/micromamba:latest

%environment
    export PATH=/opt/conda/bin:$PATH

%post
    micromamba install -y -n base -c conda-forge \
        python=3.11 jupyterlab notebook \
        pandas polars pyarrow \
        matplotlib scipy \
        scikit-learn scikit-learn-extra

    micromamba clean -afy

%runscript
    exec /opt/conda/bin/jupyter lab \
        --ip=0.0.0.0 \
        --port=8888 \
        --no-browser \
        --allow-root \
        "$@"

